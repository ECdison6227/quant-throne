    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
